# Copy to .env.local and fill in your keys
# EODHD: daily history + delayed quotes. Works from server IPs and covers
# delisted tickers. Without it, prices fall back to Yahoo (blocks datacenters).
EODHD_API_KEY=
# Finnhub: fundamentals, insider transactions, earnings. Free tier.
FINNHUB_API_KEY=
# Anthropic: the AI write-ups and the Ask-Claude endpoint.
ANTHROPIC_API_KEY=
